{
  "name": "mindex",
  "description": "AI-powered task management app with local auth and storage.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "npx tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test node --import tsx --test --experimental-test-coverage tests/unit/**/*.test.ts",
    "test:integration": "NODE_ENV=test node --import tsx --test tests/integration/server.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "form-data": "^4.0.5",
    "googleapis": "^172.0.0",
    "groq-sdk": "^1.1.2",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "socks-proxy-agent": "^10.0.0",
    "tsx": "^4.21.0",
    "undici": "^8.3.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.22",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
