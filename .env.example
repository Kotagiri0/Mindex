# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Username бота без @ (например: MindexAssistantBot)
VITE_TELEGRAM_BOT_USERNAME=

# URL приложения для установки webhook (Railway подставляет RAILWAY_PUBLIC_DOMAIN автоматически)
# APP_URL=https://your-app.railway.app

# Groq API Key (from console.groq.com)
GROQ_API_KEY=

# RouterAI API Key (routerai.ru)
ROUTERAI_API_KEY=

# PostgreSQL (Railway)
DATABASE_URL=

# Google Auth
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Supabase Configuration (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
