# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Username бота без @ (например: MindexAssistantBot)
VITE_TELEGRAM_BOT_USERNAME=

# URL приложения для установки webhook (Railway подставляет RAILWAY_PUBLIC_DOMAIN автоматически)
# APP_URL=https://your-app.railway.app

# RouterAI API Key (routerai.ru) — chat + embeddings
ROUTERAI_API_KEY=

# VseGPT API Key (vsegpt.ru) — voice transcription (Whisper)
VSEGPT_API_KEY=
ADMIN_SECRET=

# PostgreSQL (Railway)
DATABASE_URL=

# Google Auth (legacy — вход через UI отключён, аккаунты сохранены)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Yandex Auth (основной OAuth-вход)
# Получить на https://oauth.yandex.ru/ → создать приложение «Веб-сервисы».
# Callback URI приложения: https://mysle.ru/auth/yandex/callback.html
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Необязательно: фронт сам передаёт redirect_uri. Задавать только если хочешь зафиксировать.
YANDEX_REDIRECT_URI=

# Supabase Configuration (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend — транзакционные письма (OTP и т.д.)
RESEND_API_KEY=            # ключ из resend.com

# Stats Bot
STATS_BOT_TOKEN=           # токен от @BotFather для отдельного бота метрик
STATS_ALLOWED_IDS=         # Telegram ID через запятую, кому доступен /stats (например: 123456789,987654321)
STATS_DIGEST_CHAT_IDS=     # куда слать утренний дайджест (те же ID или ID группового чата)
