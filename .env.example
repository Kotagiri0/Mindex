# ─── Database (PostgreSQL / Railway) ──────────────────────────────────────────
# Railway: copy from your PostgreSQL service → Connect tab
# Docker: postgresql://user:pass@postgres:5432/dbname
DATABASE_URL=

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of this service — used to register the Telegram webhook.
# On Railway you can leave this blank and set RAILWAY_PUBLIC_DOMAIN instead,
# or fill in your Railway domain: https://<your-app>.up.railway.app
APP_URL=

# URL opened by the "Open Mindex" button inside the bot (usually same as APP_URL)
MINI_APP_URL=

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Groq API key (console.groq.com)
GROQ_API_KEY=

# RouterAI API key (routerai.ru)
ROUTERAI_API_KEY=

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Monitoring (Grafana Cloud / Prometheus) ───────────────────────────────────
# Used by docker-compose prometheus service. Leave empty if not using monitoring.
GRAFANA_CLOUD_USER_ID=
GRAFANA_CLOUD_API_KEY=

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
