# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Public URL of the app — used to register the bot webhook.
# On Railway set this to your Railway domain, e.g. https://mindex.up.railway.app
# (RAILWAY_PUBLIC_DOMAIN is read automatically if APP_URL is not set)
APP_URL=

# URL Telegram Mini App (e.g. https://mindex.up.railway.app)
MINI_APP_URL=

# Groq API Key (from console.groq.com)
GROQ_API_KEY=

# RouterAI API Key (routerai.ru)
ROUTERAI_API_KEY=

# Supabase Configuration (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
